{
  "manifest_version": 3,
  "name": "Unstuck",
  "version": "0.1.0",
  "description": "Notices when you are stuck in a YouTube video and offers a visual explanation before you ask.",
  "key": "",
  "minimum_chrome_version": "116",
  "permissions": [
    "storage",
    "offscreen"
  ],
  "host_permissions": [
    "https://www.youtube.com/*",
    "https://generativelanguage.googleapis.com/*",
    "http://127.0.0.1:4717/*",
    "https://api.openai.com/*",
    "https://api.anthropic.com/*",
    "https://api.mistral.ai/*",
    "https://api.x.ai/*",
    "https://openrouter.ai/*",
    "http://localhost/*",
    "http://127.0.0.1/*"
  ],
  "optional_host_permissions": [
    "https://*/*",
    "http://*/*"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_title": "Unstuck: setup and stats"
  },
  "content_scripts": [
    {
      "matches": [
        "https://www.youtube.com/*"
      ],
      "js": [
        "page.js"
      ],
      "world": "MAIN",
      "run_at": "document_start"
    },
    {
      "matches": [
        "https://www.youtube.com/*"
      ],
      "js": [
        "content.js"
      ],
      "css": [
        "content.css"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://*.panopto.com/Panopto/Pages/*",
        "https://*.panopto.eu/Panopto/Pages/*"
      ],
      "js": [
        "panopto.js"
      ],
      "all_frames": true,
      "run_at": "document_idle"
    }
  ],
  "content_security_policy": {
    "extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self'",
    "sandbox": "sandbox allow-scripts; default-src 'none'; script-src 'self' 'unsafe-inline' 'unsafe-eval'; style-src 'unsafe-inline'; img-src data: blob:; font-src data:; media-src data: blob:; worker-src blob:; connect-src 'none'"
  },
  "sandbox": {
    "pages": [
      "sim.html"
    ]
  },
  "web_accessible_resources": [
    {
      "resources": [
        "sim.html",
        "sim.js",
        "three.js"
      ],
      "matches": [
        "https://www.youtube.com/*",
        "https://*.panopto.com/*",
        "https://*.panopto.eu/*"
      ]
    }
  ]
}
